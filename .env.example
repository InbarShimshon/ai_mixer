# Spotify app credentials — create an app at https://developer.spotify.com/dashboard
# Add redirect URI:  http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# GetSongBPM API key — free at https://getsongbpm.com/api (requires a backlink on your site)
GETSONGBPM_API_KEY=

# Anthropic API key — for AI song suggestions. Get one at https://console.anthropic.com
# Optional: the app works without it; the "Suggest more" button is disabled until set.
ANTHROPIC_API_KEY=

PORT=8888

# Optional: shared access password — set it to require a password before anyone can use the app.
APP_PASSWORD=
